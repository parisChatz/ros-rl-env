<launch>

  <arg name="robot_name" default="p3dx" />
  <arg name="node_start_delay" default="1.0" /> 
  <arg name="robot_position" default="-x -1.0 -y 5.0 -z 0.01" />
  <arg name="urdf_spawner_name" default="urdf_spawner" />
  <arg name="robot_state_publisher_name" default="robot_state_publisher" />
  <arg name="joint_state_publisher_name" default="joint_state_publisher" />

    <!-- Load the URDF into the ROS Parameter Server -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find multi_robot_scenario)/xacro/p3dx/pioneer3dx.xacro'" />

    <!-- Run a python script to the send a service call to gazebo_ros to spawn a URDF robot -->
    <node name="$(arg urdf_spawner_name)" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen" launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@' " args="-urdf -model $(arg robot_name) -param robot_description $(arg robot_position) "/>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="$(arg robot_state_publisher_name)">
      <param name="publish_frequency" type="double" value="100.0"/>
      <param name="tf_prefix" type="string" value="$(arg robot_name)"/>
    </node>
  
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="$(arg joint_state_publisher_name)">
      <param name="publish_frequency" type="double" value="100.0"/>
  </node>

</launch>
